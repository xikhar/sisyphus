{
  "name": "sisyphus",
  "version": "1.0.0",
  "private": true,
  "description": "A painterly Sisyphus game built with Three.js.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run build",
    "test:browser": "node scripts/browser-test.mjs",
    "test:record": "node scripts/record-test.mjs",
    "test:production": "node scripts/production-test.mjs",
    "setup:browser": "playwright install chromium",
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "assets:optimize": "node scripts/optimize-assets.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "sharp": "^0.35.4",
    "vite": "^7.1.7"
  }
}
